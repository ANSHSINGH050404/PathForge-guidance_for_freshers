# Database
DATABASE_URL=postgresql://your_neon_connection_string_here

# Authentication
BETTER_AUTH_SECRET=your_secret_here_use_openssl_rand_hex_32
BETTER_AUTH_URL=http://localhost:3000 # Update to https://your-app.vercel.app in production
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000 # MUST match BETTER_AUTH_URL

# OAuth Providers - Google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth Providers - GitHub
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# AI - Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Custom AI Models (defaults shown)
# GEMINI_MODEL_CAREER_PATH=gemini-2.0-flash
# GEMINI_MODEL_CAREER=gemini-2.0-flash
# GEMINI_MODEL_RESUME=gemini-1.5-flash
